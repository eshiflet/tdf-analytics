# Dependencies
cycling-app/node_modules/

# Build output (regenerate with: cd cycling-app && npm run build)
cycling-app/build/
cycling-app/dist/

# Generated per-race SEO landing pages (regenerate with: npm run generate:pages)
cycling-app/tour/
cycling-app/giro/
cycling-app/vuelta/

# Vite dev-server temp files
cycling-app/vite.config.ts.timestamp-*.mjs
cycling-app/tsconfig.tsbuildinfo

# AI Context file for Claude for future development
ai-context.md
architecture.md

# Database (large binary — NOT regenerable; back up with pipeline/db_backup.py)
pipeline/cycling.db
pipeline/cycling.db.bak*
pipeline/db_backups/

# Rider detail scrape cache (intermediate; ingested into cycling.db via scrape_rider_details.py)
pipeline/rider_scrapes/

# Raw scraped data (tdf_*_full.json, scrapes/, giro_scrapes/, vuelta_scrapes/)
# is deliberately TRACKED in git — it is the only copy outside this machine.

# Claude Code — machine-specific settings (launch.json is committed; settings.local.json is not)
.claude/settings.local.json

# macOS
.DS_Store

# Python bytecode
__pycache__/
*.pyc
