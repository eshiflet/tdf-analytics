# Dependencies
cycling-app/node_modules/

# Build output (regenerate with: cd cycling-app && npm run build)
cycling-app/build/
cycling-app/dist/

# Generated per-race SEO landing pages (regenerate with: npm run generate:pages)
cycling-app/tour/
cycling-app/giro/
cycling-app/vuelta/
cycling-app/classics/
cycling-app/gravel/

# Vite dev-server temp files
cycling-app/vite.config.ts.timestamp-*.mjs
cycling-app/tsconfig.tsbuildinfo

# AI Context file for Claude for future development
ai-context.md
architecture.md

# Database (large binary — NOT regenerable; back up with pipeline/db_backup.py)
pipeline/cycling.db
pipeline/cycling.db.bak*
pipeline/db_backups/

# Rider detail scrape cache (intermediate; ingested into cycling.db via scrape_rider_details.py)
pipeline/rider_scrapes/

# Raw scraped data (tdf_*_full.json, scrapes/, giro_scrapes/, vuelta_scrapes/)
# is deliberately TRACKED in git — it is the only copy outside this machine.

# Claude Code — machine-specific settings (launch.json is committed; settings.local.json is not)
.claude/settings.local.json

# macOS
.DS_Store

# Python bytecode
__pycache__/
*.pyc

# bikeraceinfo raw page cache (regenerable: scrape_bikeraceinfo_teams.py re-fetches;
# the parsed per-race JSON beside it IS tracked)
pipeline/bikeraceinfo_teams/_pages/

# Athlinks raw API responses (regenerable: scrape_athlinks.py re-fetches; the
# selected per-race-year JSON beside it IS tracked). A local fetch cache, kept
# because the field-selection logic has needed correcting after the fetch more
# than once and re-deriving from cache takes seconds instead of half an hour.
pipeline/gravel_scrapes/_raw/

# Run log, and the machine-readable half of the one-off Athlinks reconnaissance.
# _survey.txt IS tracked — it is the readable record of what every edition of
# every race publishes, and re-deriving it costs ten minutes of network.
pipeline/gravel_scrapes/_scrape.log
pipeline/gravel_scrapes/_survey.json
